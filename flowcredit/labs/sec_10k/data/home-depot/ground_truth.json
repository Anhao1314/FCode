  {
    "fact": "audit_opinion",
    "value": "standard_unqualified",
    "unit": "code",
    "source_unit": "code",
    "period": "FY2025",
    "doc_id": "doc_10k_fy2025",
    "line": 6,
    "snippet": "We have audited the accompanying consolidated balance sheets of The Home Depot, Inc. and its subsidiaries (the Company) as of February 1, 2026 and February 2, 2025, the related consolidated statements of earnings, comprehensive income, stockholders’ equity, and cash flows for each of the fiscal years in the three-year period ended February 1, 2026, and the related notes (collectively, the consolidated financial statements). In our opinion, the consolidated financial statements present fairly, in all material respects, the financial position of the Company as of February 1, 2026 and February 2, 2025, and the results of its operations and its cash flows for each of the fiscal years in the three-year period ended February 1, 2026, in conformity with U.S. generally accepted accounting principles.",
    "source_url": "https://www.sec.gov/Archives/edgar/data/354950/000162828026019436/hd-20260201.htm",
    "accession": "0001628280-26-019436"
  },
